    {
      "parameters": {
        "jsCode": "function stripXmlTimedtext(xml) {\n    const cues = [];\n    const re = /<text start=\"([\\d.]+)\" dur=\"([\\d.]+)\"[^>]*>([\\s\\S]*?)<\\/text>/g;\n    let m;\n    while ((m = re.exec(xml)) !== null) {\n        const start = parseFloat(m[1]);\n        const dur = parseFloat(m[2]);\n        const text = m[3]\n            .replace(/&amp;/g, \"&\")\n            .replace(/&#39;/g, \"'\")\n            .replace(/&quot;/g, '\"')\n            .replace(/<[^>]+>/g, \"\")\n            .trim();\n        if (text) {\n            cues.push({ start, end: start + dur, text });\n        }\n    }\n    return cues;\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n    const json = item.json;\n    const metadata = json.metadata ?? {};\n    let cues = [];\n    if (Array.isArray(metadata.transcript_json) && metadata.transcript_json.length) {\n        cues = metadata.transcript_json;\n    } else if (Array.isArray(json.transcript_json) && json.transcript_json.length) {\n        cues = json.transcript_json;\n    } else {\n        const transcript =\n            metadata.transcriptRaw ??\n            metadata.transcript_text ??\n            metadata.transcript_llm ??\n            json.transcriptRaw ??\n            json.transcript_text ??\n            json.transcript_llm ??\n            \"\";\n        const format = metadata.transcriptFormat ?? json.transcriptFormat ?? \"\";\n        if (format === \"xml\") {\n            cues = stripXmlTimedtext(transcript);\n        } else {\n            cues = [{ start: 0, end: 0, text: transcript }];\n        }\n    }\n    const cleanedFullText = cues.map(c => c.text).join(\" \").replace(/\\s+/g, \" \").trim();\n    output.push({ json: { ...json, metadata, cues, cleanedFullText } });\n}\n\nreturn output;"
      },
      "id": "888412b8-3692-481c-a633-b2074cf0adfb",
      "name": "Clean Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        -1328
      ]
    },
    {
      "parameters": {
        "jsCode": "const TARGET_TOKENS = 500;\nconst OVERLAP_RATIO = 0.15;\nconst WORDS_PER_TOKEN = 0.75;\n\nfunction wordsToTokens(words) { return Math.round(words.length / WORDS_PER_TOKEN); }\n\nconst out = [];\nfor (const item of $input.all()) {\n  const json = item.json;\n  const cues = json.cues || [];\n  const words = json.cleanedFullText.split(/\\s+/).filter(Boolean);\n  if (words.length === 0) continue;\n\n  const targetWords = Math.round(TARGET_TOKENS * WORDS_PER_TOKEN);\n  const overlapWords = Math.round(targetWords * OVERLAP_RATIO);\n  const step = Math.max(1, targetWords - overlapWords);\n\n  const wordTimes = [];\n  for (const cue of cues) {\n    const cueWords = cue.text.split(/\\s+/).filter(Boolean);\n    for (let i = 0; i < cueWords.length; i++) {\n      const frac = cueWords.length > 1 ? i / (cueWords.length - 1) : 0;\n      wordTimes.push(cue.start + frac * (cue.end - cue.start));\n    }\n  }\n\n  let chunkIndex = 0;\n  for (let i = 0; i < words.length; i += step) {\n    const slice = words.slice(i, i + targetWords);\n    if (slice.length < 20 && chunkIndex > 0) break;\n    const content = slice.join(' ');\n    const startSeconds = wordTimes[i] ?? 0;\n    const endIdx = Math.min(i + slice.length - 1, wordTimes.length - 1);\n    const endSeconds = wordTimes[endIdx] ?? startSeconds;\n    out.push({\n      json: {\n        videoRowId: $('Claim Video for Processing').item.json.id,\n        videoId: json.metadata.id,\n        chunkIndex: chunkIndex,\n        content,\n        startSeconds,\n        endSeconds,\n        tokenCount: wordsToTokens(slice),\n        transcriptSource: json.transcriptSource\n      }\n    });\n    chunkIndex++;\n    if (i + targetWords >= words.length) break;\n  }\n}\nreturn out;"
      },
