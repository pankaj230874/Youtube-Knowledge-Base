    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  const first = Array.isArray(data) ? data[0] : data['0'] || data;\n  const transcriptRaw =\n    first?.transcript_text ??\n    first?.transcript_llm ??\n    first?.transcript ??\n    first?.captions ??\n    \"\";\n  const isWhisper = !!(first && (first.type === 'whisper' || first.aiFallbackUsed));\n  results.push({\n    json: {\n      ...item.json,\n      transcriptRaw,\n      transcriptFormat: 'plain',\n      transcriptSource: isWhisper ? 'apify-whisper' : 'apify-caption'\n    }\n  });\n}\nreturn results;"
