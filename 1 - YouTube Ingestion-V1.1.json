      "parameters": {
        "jsCode": "function stripXmlTimedtext(xml) {\n  const cues = [];\n  const re = /<text start=\"([\\d.]+)\" dur=\"([\\d.]+)\"[^>]*>([\\s\\S]*?)<\\/text>/g;\n  let m;\n  while ((m = re.exec(xml)) !== null) {\n    const start = parseFloat(m[1]);\n    const dur = parseFloat(m[2]);\n    const text = m[3]\n      .replace(/&amp;/g, \"&\")\n      .replace(/&#39;/g, \"'\")\n      .replace(/&quot;/g, '\"')\n      .replace(/<[^>]+>/g, \"\")\n      .trim();\n    if (text) cues.push({ start, end: start + dur, text });\n  }\n  return cues;\n}\n\nconst nm = $('Normalize Metadata').item.json;\nconst raw = $input.item.json;\nconst xmlText = (typeof raw === 'string') ? raw : (raw.data ?? raw.body ?? '');\nconst cues = stripXmlTimedtext(xmlText || '');\nconst cleanedFullText = cues.map(c => c.text).join(' ').replace(/\\s+/g, ' ').trim();\n\nreturn [{\n  json: {\n    hasCaptions: cues.length > 0,\n    transcriptRaw: cleanedFullText,\n    transcriptFormat: 'plain',\n    transcriptSource: 'timedtext',\n    transcript_json: cues,\n    metadata: {\n      id: nm.videoId,\n      title: nm.videoTitle,\n      channel: nm.channelName,\n      url: nm.videoUrl,\n      duration: null\n    }\n  }\n}];"
      },
